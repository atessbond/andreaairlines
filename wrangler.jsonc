{
  "name": "andreaairlines",
  "compatibility_date": "2026-07-10",
  // The site lives only at www.andreaairlines.com. Absent, this defaults
  // to true and every deploy would re-assert the workers.dev address.
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./site"
  }
}
